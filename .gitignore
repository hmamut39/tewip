node_modules/
test-results/
playwright-report/
blob-report/

# Collected triage data stays local; keep only the directory itself.
data/*
!data/.gitkeep

# Hand labels for real CI failures describe collected failure data; they stay local too.
# Every label file for real CI failures, by pattern rather than by name. This was a list of
# eleven filenames, and a list is only right until the next dataset: harvesting gutenberg-local
# in Phase 56 produced a twelfth that nothing matched, and `git add -A` committed it. The
# synthetic fixtures are invented data and belong in the repository; nothing else here does.
eval/ground-truth.jsonl
eval/ground-truth.*.jsonl
!eval/ground-truth.synthetic.jsonl

# Secrets (API keys) never leave this machine.
.env
.env.*

# Polyglot fixtures: installed packages and runner outputs.
fixtures/polyglot/**/node_modules/
fixtures/polyglot/**/out/
fixtures/polyglot/java/target/
fixtures/polyglot/rust/target/
fixtures/polyglot/php/vendor/

# Tewip: local command-line history and the published build.
.tewip/
dist/
*.tgz
*.vsix

# Generated by the GitHub Action and by local dry runs of it.
.triage-agent/

# Commit-message scratch files. PowerShell needs a file to get real line breaks into a
# commit message, and `git add -A` has now swept one into a phase commit twice.
.m
msg.txt
.mm
.cm
