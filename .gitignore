eval/ground-truth.penpot.jsonl
eval/ground-truth.ghost.jsonl
eval/ground-truth.aug.jsonl
eval/ground-truth.aug2.jsonl

# Secrets (API keys) never leave this machine.
.env
.env.*
eval/ground-truth.jupyterlab.jsonl
eval/ground-truth.lxdui.jsonl
eval/ground-truth.nextcloud.jsonl

# Polyglot fixtures: installed packages and runner outputs.
fixtures/polyglot/**/node_modules/
fixtures/polyglot/**/out/
fixtures/polyglot/java/target/
fixtures/polyglot/rust/target/
fixtures/polyglot/php/vendor/

# Tewip: local command-line history and the published build.
.tewip/
dist/
*.tgz
*.vsix

# Generated by the GitHub Action and by local dry runs of it.
.triage-agent/

# Commit-message scratch files. PowerShell needs a file to get real line breaks into a
# commit message, and `git add -A` has now swept one into a phase commit twice.
.m
msg.txt
.mm
.cm
