{
  "name": "tewip",
  "displayName": "Tewip - why did my test fail?",
  "description": "Finds why each failing test failed - real bug, flaky, environment, test data or changed selector - for any stack. Reviews the risk of your change, weighs flaky tests, checks secrets and dependencies, and connects Tewip to your editor AI assistant.",
  "version": "0.5.0",
  "publisher": "hmamut39",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hmamut39/tewip.git",
    "directory": "extensions/vscode"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Testing",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "test failures",
    "flaky tests",
    "triage",
    "playwright",
    "pytest",
    "jest",
    "junit",
    "ci",
    "root cause",
    "sdet"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "tewip",
        "label": "Tewip"
      }
    ],
    "commands": [
      {
        "command": "tewip.explainReport",
        "title": "Explain a test report…",
        "category": "Tewip"
      },
      {
        "command": "tewip.ciReport",
        "title": "Why did CI fail on this branch?",
        "category": "Tewip"
      },
      {
        "command": "tewip.review",
        "title": "Risk review of this change",
        "category": "Tewip"
      },
      {
        "command": "tewip.flaky",
        "title": "Which flaky tests to quarantine",
        "category": "Tewip"
      },
      {
        "command": "tewip.secure",
        "title": "Check secrets and dependencies",
        "category": "Tewip"
      },
      {
        "command": "tewip.learn",
        "title": "What our corrections add up to",
        "category": "Tewip"
      }
    ],
    "configuration": {
      "title": "Tewip",
      "properties": {
        "tewip.path": {
          "type": "string",
          "default": "tewip",
          "markdownDescription": "How to run Tewip: leave it as `tewip` when it is installed with `npm install -g tewip-ai`, or give the path to `cli/tewip.ts` (or `dist/cli/tewip.js`) in a checkout."
        }
      }
    }
  },
  "bugs": {
    "url": "https://github.com/hmamut39/tewip/issues"
  },
  "homepage": "https://github.com/hmamut39/tewip#readme"
}
