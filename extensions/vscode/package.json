{
  "name": "tewip",
  "displayName": "Tewip - why did my test fail?",
  "description": "Proves the work: is this change done, could these tests ever fail, would they catch a bug, what will this migration do to a live database, and why did CI fail.",
  "version": "0.7.1",
  "publisher": "hmamut39",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hmamut39/tewip.git",
    "directory": "extensions/vscode"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Testing",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ci",
    "code review",
    "flaky tests",
    "jest",
    "junit",
    "mcp",
    "migrations",
    "mutation testing",
    "playwright",
    "pytest",
    "qa",
    "root cause",
    "sdet",
    "test failures",
    "test triage",
    "testing",
    "triage"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "tewip",
        "label": "Tewip"
      }
    ],
    "commands": [
      {
        "command": "tewip.explainReport",
        "title": "Explain a test report\u2026",
        "category": "Tewip"
      },
      {
        "command": "tewip.ciReport",
        "title": "Why did CI fail on this branch?",
        "category": "Tewip"
      },
      {
        "command": "tewip.review",
        "title": "Risk review of this change",
        "category": "Tewip"
      },
      {
        "command": "tewip.flaky",
        "title": "Which flaky tests to quarantine",
        "category": "Tewip"
      },
      {
        "command": "tewip.secure",
        "title": "Check secrets and dependencies",
        "category": "Tewip"
      },
      {
        "command": "tewip.learn",
        "title": "What our corrections add up to",
        "category": "Tewip"
      },
      {
        "command": "tewip.recall",
        "title": "Has this happened here before?",
        "category": "Tewip"
      },
      {
        "command": "tewip.trace",
        "title": "Is this requirement covered, and passing?",
        "category": "Tewip"
      },
      {
        "command": "tewip.pursue",
        "title": "What should be done next about\u2026?",
        "category": "Tewip"
      },
      {
        "command": "tewip.attest",
        "title": "What did Tewip check for this build?",
        "category": "Tewip"
      },
      {
        "command": "tewip.done",
        "title": "Tewip: Is this work done?"
      },
      {
        "command": "tewip.vouch",
        "title": "Tewip: Could these tests ever fail?"
      },
      {
        "command": "tewip.prove",
        "title": "Tewip: Would the tests catch a bug in this file?"
      },
      {
        "command": "tewip.pick",
        "title": "Tewip: Which tests could notice this change?"
      },
      {
        "command": "tewip.schema",
        "title": "Tewip: What will this migration do to a live database?"
      },
      {
        "command": "tewip.standards",
        "title": "Tewip: This project's own standards"
      }
    ],
    "configuration": {
      "title": "Tewip",
      "properties": {
        "tewip.path": {
          "type": "string",
          "default": "tewip",
          "markdownDescription": "How to run Tewip: leave it as `tewip` when it is installed with `npm install -g tewip-ai`, or give the path to `cli/tewip.ts` (or `dist/cli/tewip.js`) in a checkout."
        }
      }
    }
  },
  "bugs": {
    "url": "https://github.com/hmamut39/tewip/issues"
  },
  "homepage": "https://github.com/hmamut39/tewip#readme",
  "author": {
    "name": "Mamuti Aishan (Hasan)"
  }
}
