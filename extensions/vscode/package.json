{
  "name": "tewip",
  "displayName": "Tewip - why did my test fail?",
  "description": "Finds why each failing test failed (real bug, flaky, environment, test data or changed selector) for any stack, and connects Tewip to your editor's AI assistant.",
  "version": "0.4.0",
  "publisher": "hmamut39",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hmamut39/tewip.git",
    "directory": "extensions/vscode"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Testing",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "test failures",
    "flaky tests",
    "triage",
    "playwright",
    "pytest",
    "jest",
    "junit",
    "ci",
    "root cause",
    "sdet"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "tewip",
        "label": "Tewip"
      }
    ],
    "commands": [
      {
        "command": "tewip.explainReport",
        "title": "Explain a test report\u2026",
        "category": "Tewip"
      },
      {
        "command": "tewip.ciReport",
        "title": "Why did CI fail on this branch?",
        "category": "Tewip"
      }
    ],
    "configuration": {
      "title": "Tewip",
      "properties": {
        "tewip.path": {
          "type": "string",
          "default": "tewip",
          "markdownDescription": "How to run Tewip: `tewip` when it is installed from its release file (`npm install -g tewip-<version>.tgz`), or the path to `cli/tewip.ts` (or `dist/cli/tewip.js`) in a checkout."
        }
      }
    }
  },
  "bugs": {
    "url": "https://github.com/hmamut39/tewip/issues"
  },
  "homepage": "https://github.com/hmamut39/tewip#readme"
}
