{
  "name": "tewip-ai",
  "version": "0.51.0",
  "mcpName": "io.github.hmamut39/tewip",
  "description": "Tewip finds why each failing test failed - real bug, flaky test, environment, test data or changed selector - for any stack, from the command line, CI, or your editor.",
  "keywords": [
    "test-failures",
    "flaky-tests",
    "triage",
    "root-cause",
    "ci",
    "github-action",
    "playwright",
    "pytest",
    "jest",
    "vitest",
    "junit",
    "mcp",
    "ai-agent",
    "test-automation",
    "qa",
    "sdet",
    "devops"
  ],
  "homepage": "https://github.com/hmamut39/tewip#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/hmamut39/tewip.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "tewip": "dist/cli/tewip.js"
  },
  "files": [
    "LICENSE",
    "QUICKSTART.md",
    "README.md",
    "TEAM-GUIDE.md",
    "dist/"
  ],
  "scripts": {
    "test": "playwright test",
    "test:loop": "node scripts/test-loop.ts 5",
    "history": "node scripts/history.ts",
    "diagnose": "node scripts/diagnose.ts",
    "triage": "node scripts/triage.ts",
    "explain": "node scripts/explain.ts",
    "lab": "node scripts/lab.ts",
    "test:engine": "node --test engine/test/*.test.ts outlets/test/*.test.ts mcp/test/*.test.ts",
    "mcp": "node mcp/server.ts",
    "eval": "node eval/evaluate.ts eval/ground-truth.jsonl --data data/real/gutenberg",
    "eval:holdout": "node eval/evaluate.ts eval/ground-truth.holdout.jsonl --data data/real/gutenberg-holdout",
    "eval:fresh": "node eval/evaluate.ts eval/ground-truth.fresh.jsonl --data data/real/gutenberg-fresh",
    "eval:aug": "node eval/evaluate.ts eval/ground-truth.aug.jsonl --data data/real/gutenberg-aug",
    "eval:aug2": "node eval/evaluate.ts eval/ground-truth.aug2.jsonl --data data/real/gutenberg-aug2",
    "eval:supabase": "node eval/evaluate.ts eval/ground-truth.supabase.jsonl --data data/real/supabase",
    "shadow": "node scripts/shadow.ts",
    "harvest": "node eval/harvest/harvest.ts",
    "eval:synthetic": "node eval/evaluate.ts eval/ground-truth.synthetic.jsonl",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "tewip": "node cli/tewip.ts"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "bugs": {
    "url": "https://github.com/hmamut39/tewip/issues"
  },
  "author": {
    "name": "Mamuti Aishan (Hasan)",
    "url": "https://github.com/hmamut39"
  }
}
