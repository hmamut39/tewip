{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "cli",
    "tests",
    "reporters",
    "engine",
    "outlets",
    "ci",
    "mcp",
    "eval",
    "scripts",
    "fixtures",
    "lab",
    "playwright.config.ts"
  ]
}
